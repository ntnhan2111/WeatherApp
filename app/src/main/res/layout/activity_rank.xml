<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thống Kê Thang Đo Kỷ Lục"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp" />

        <!-- Khối 1: Thông tin phân tích cực trị -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="thông tin cần biết"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#00796B"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvMaxRecord"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nhiệt độ cao nhất: Đang tính toán..."
                    android:textColor="#C62828"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tvMinRecord"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nhiệt độ thấp nhất: Đang tính toán..."
                    android:textColor="#1565C0"
                    android:layout_marginBottom="12dp"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tvStableRecord"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nhiệt độ ổn định nhất: Đang tính toán..."
                    android:textColor="#2E7D32"
                    android:textSize="14sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Khối 2: Danh sách sắp xếp theo thứ tự toán học -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Danh Sách Chi Tiết"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#EF6C00" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bảng xếp hạng nhiệt độ từ cao đến thấp:"
                    android:textColor="#757575"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvRankList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Đang tính toán thứ hạng danh sách..."
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:lineSpacingExtra="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
