<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trí Tuệ Nhân Tạo Lên Kế Hoạch"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#6A1B9A"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vùng vị trí cần AI phân tích:"
            android:textSize="14sp"
            android:textColor="#333333" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <EditText
                android:id="@+id/etAiCity"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:hint="Nhập tên tỉnh/thành phố"
                android:background="@android:drawable/editbox_background_normal"
                android:paddingStart="10dp"
                android:paddingEnd="40dp"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_btn_speak_now"
                android:layout_alignParentEnd="true"
                android:layout_centerInParent="true"
                android:layout_marginEnd="10dp"
                app:tint="#757575"
                android:contentDescription="Mic" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">

            <Button
                android:id="@+id/btnPickImage"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Chọn ảnh từ máy"
                android:textAllCaps="false"
                android:backgroundTint="#5C88FF"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnCaptureImage"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Chụp ảnh thực tế"
                android:textAllCaps="false"
                android:backgroundTint="#5C88FF" />
        </LinearLayout>

        <Button
            android:id="@+id/btnAnalyze"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Phân Tích Khí Hậu &amp; Lịch Trình Với AI"
            android:textAllCaps="false"
            android:backgroundTint="#6A1B9A"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phản hồi chi tiết từ Mô hình AI:"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginTop="20dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/tvAiResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="160dp"
                android:background="#E8F5E9"
                android:text="Vui lòng nhấn nút ở trên để bắt đầu xử lý..."
                android:textColor="#2E7D32"
                android:textSize="15sp"
                android:padding="16dp"
                android:lineSpacingExtra="6dp" />
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
